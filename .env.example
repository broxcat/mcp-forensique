# Copy to .env and adapt. Use forward slashes on Windows.
# Fixed Compose project name: one deployment folder only (README §3). Without it the project is
# named after the folder, and a second clone can silently recreate the container on old code.
COMPOSE_PROJECT_NAME=forensic-mcp
EVIDENCE_DIR=C:/cases/evidence
OUTPUT_DIR=C:/cases/output
# Open WebUI session secret: random string of 32+ chars, never commit the real one.
WEBUI_SECRET_KEY=change-me-to-a-random-string-of-32-plus-characters
# Optional: Ollama URL as seen from the webui container (default: Ollama on the Windows host).
# OLLAMA_BASE_URL=http://host.docker.internal:11434
