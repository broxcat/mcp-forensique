#!/usr/bin/env python3
"""Fake capinfos -M -S ... <file>: the long report of the real tool, machine-readable values and
epoch times, computed from the JSON "capture" ({"packets": [{frame.time_epoch, frame.len}, ...]}).
"""
import json
import sys

path = sys.argv[-1]
try:
    with open(path, encoding="utf-8") as fh:
        packets = json.load(fh)["packets"]
except Exception:
    print(f"capinfos: An error occurred after reading 0 packets from \"{path}\".",
          file=sys.stderr)
    sys.exit(2)

times = sorted(float(p["frame.time_epoch"]) for p in packets if p.get("frame.time_epoch"))
data = sum(int(p.get("frame.len", 0)) for p in packets)
print(f"File name:           {path}")
print("File type:           Wireshark/tcpdump/... - pcap")
print("File encapsulation:  Ethernet")
print(f"Number of packets:   {len(packets)}")
print(f"File size:           {data + 24 + 16 * len(packets)} bytes")
print(f"Data size:           {data} bytes")
print("Packet size limit:   65535")
if times:
    print(f"Capture duration:    {times[-1] - times[0]:.6f} seconds")
    print(f"First packet time:   {times[0]:.6f}")
    print(f"Last packet time:    {times[-1]:.6f}")
print("Strict time order:   True")
