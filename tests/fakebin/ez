def arg(args, flag):
    return args[args.index(flag) + 1] if flag in args else None


def write_csv(path, rows):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    cols = list(dict.fromkeys(k for r in rows for k in r))
    with open(path, "w", newline="", encoding="utf-8") as fh:
        w = csv.DictWriter(fh, fieldnames=cols)
        w.writeheader()
        w.writerows(rows)


def write_jsonl(path, rows):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8-sig") as fh:  # BOM, like the real EvtxECmd
        for r in rows:
            fh.write(json.dumps(r) + "\n")


def main() -> int:
    tool = os.path.splitext(os.path.basename(sys.argv[1]))[0]
    args = sys.argv[2:]
    src = arg(args, "-f") or arg(args, "-d")
    jdir, cdir = arg(args, "--json"), arg(args, "--csv")
    if "silent" in (src or ""):  # mimics the real bstrings 2026.5.0 on Linux: exit 0, no output
        print("input from stdin or file")
        return 0
    if "crash" in (src or ""):  # mimics the real SQLECmd on Linux: exit 0 + empty JSON file
        if jdir:
            write_jsonl(os.path.join(jdir, f"{tool}_Output.json"), [])
        print("Unhandled exception: System.DllNotFoundException: Unable to load shared library "
              "'SQLite.Interop.dll' or one of its dependencies.")
        return 0
    if tool == "EvtxECmd" and jdir:
        inc = arg(args, "--inc")
        rows = [r for r in EVTX if not inc or str(r["EventId"]) in inc.split(",")]
        write_jsonl(os.path.join(jdir, "20261006_EvtxECmd_Output.json"), rows)
    elif tool in JSON_ROWS and jdir:
        write_jsonl(os.path.join(jdir, f"20261006_{tool}_Output.json"), JSON_ROWS[tool])
    elif tool == "AmcacheParser":  # several CSVs, like the real tool
        write_csv(os.path.join(cdir, "Amcache_UnassociatedFileEntries.csv"),
                  [{"SHA1": "0000" + "ab" * 20, "FullPath": "c:\\users\\public\\upd.exe",
                    "Name": "upd.exe", "FileKeyLastWriteTimestamp": "2026-10-06 14:31:10"}])
        write_csv(os.path.join(cdir, "Amcache_ProgramEntries.csv"), [{"Name": "Office"}])
    elif tool in CSV_ROWS and cdir:
        write_csv(os.path.join(cdir, f"{tool}_Output.csv"), CSV_ROWS[tool])
    elif tool == "bstrings":
        with open(arg(args, "-o"), "w") as fh:
            fh.write("hello world\nhttp://203.0.113.10/a.ps1\n")
    elif tool == "rla":
        os.makedirs(arg(args, "--out"), exist_ok=True)
        with open(os.path.join(arg(args, "--out"), "SYSTEM"), "wb") as fh:
            fh.write(b"regf")
    elif tool == "SrumECmd" and not os.path.basename(src or "").lower().startswith("srudb"):
        print("fake SrumECmd: not a SRUDB.dat", file=sys.stderr)
        return 1
    elif cdir or jdir:
        row = {"Tool": tool, "SourceFile": src, "Args": " ".join(args)}
        if jdir:
            write_jsonl(os.path.join(jdir, f"{tool}_Output.json"), [row])
        else:
            write_csv(os.path.join(cdir, f"{tool}_Output.csv"), [row])
    else:
        print(f"fake ez: no output option for {tool}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
