#!/usr/bin/env python3
"""Fake Volatility 2.6 for unit tests: --info, -h, imageinfo, JSON output and a text-only plugin."""
import json
import os
import sys

INFO = """Volatility Foundation Volatility Framework 2.6

Profiles
--------
Win7SP1x64            - A Profile for Windows 7 SP1 x64
WinXPSP2x86           - A Profile for Windows XP SP2 x86

Address Spaces
--------------
FileAddressSpace          - This is a direct file AS

Plugins
-------
cmdline                    - Display process command-line arguments
hashdump                   - Dumps passwords hashes (LM/NTLM) from memory
imageinfo                  - Identify information for the image
printkey                   - Print a registry key, and its subkeys and values
procdump                   - Dump a process to an executable file sample
pslist                     - Print all running processes by following the EPROCESS lists
vaddump                    - Dumps out the vad sections to a file
yarascan                   - Scan process or kernel memory with Yara signatures
"""
GLOBAL = """Usage: Volatility - A memory forensics analysis platform.

Options:
  -h, --help            list all available options and their default values.
  -f FILENAME, --filename=FILENAME
                        Filename to use when opening an image
  --profile=WinXPSP2x86
                        Name of the profile to load
  --plugins=PLUGINS     Additional plugin directories to use (colon separated)
  -w, --write           Enable write support
  --output=text         Output in this format
  --output-file=OUTPUT_FILE
                        Write output in this file
"""
PLUGIN_OPTS = {
    "pslist": ["  -o OFFSET, --offset=OFFSET", "                        EPROCESS offset (in hex)",
               "  -p PID, --pid=PID     Operate on these Process IDs (comma-separated)",
               "  -P, --physical-offset", "                        Display physical offsets"],
    "cmdline": ["  -o OFFSET, --offset=OFFSET", "  -p PID, --pid=PID     Operate on these PIDs"],
    "procdump": ["  -D DUMP_DIR, --dump-dir=DUMP_DIR", "  -p PID, --pid=PID     PIDs"],
    # copied from the real `vol2 <plugin> -h` (2.6 standalone)
    "printkey": ["  -o HIVE_OFFSET, --hive-offset=HIVE_OFFSET",
                 "                        Hive offset (virtual)",
                 "  -K KEY, --key=KEY     Registry Key"],
    "yarascan": ["  -o OFFSET, --offset=OFFSET",
                 "  -p PID, --pid=PID     Operate on these Process IDs (comma-separated)",
                 "  -C, --case            Make the search case insensitive",
                 "  -W, --wide            Match wide (unicode) strings",
                 "  -Y YARA_RULES, --yara-rules=YARA_RULES",
                 "                        Yara rules (as a string)",
                 "  -y YARA_FILE, --yara-file=YARA_FILE",
                 "  -D DUMP_DIR, --dump-dir=DUMP_DIR"],
    "vaddump": ["  -p PID, --pid=PID     Operate on these Process IDs (comma-separated)",
                "  -D DUMP_DIR, --dump-dir=DUMP_DIR",
                "                        Directory in which to dump the VAD files",
                "  -b BASE, --base=BASE  Dump VAD with BASE address (in hex)",
                "  -M 1073741824, --max-size=1073741824"],
}
URL = b"http://203.0.113.10/a.pdf"
PSLIST = {"columns": ["Offset(V)", "Name", "PID", "PPID", "Thds", "Hnds", "Sess", "Wow64",
                      "Start", "Exit"],
          "rows": [[18446738026458983216, "System", 4, 0, 87, 547, -1, 0,
                    "2019-03-22 05:31:55 UTC+0000", ""],
                   [18446738026469089344, "smss.exe", 252, 4, 2, 30, -1, 0,
                    "2019-03-22 05:31:55 UTC+0000", ""]]}
HASHDUMP = {"columns": ["User", "RID", "LM", "NT"], "rows": [["Administrator", 500, "aad3", "31d6"]]}


def opt(args, name):
    return next((a.split("=", 1)[1] for a in args if a.startswith(name + "=")), None)


def main() -> int:
    args = sys.argv[1:]
    if args == ["--info"]:
        print(INFO)
        return 0
    plugin = next((a for a in args if a in ("pslist", "cmdline", "hashdump", "imageinfo",
                                             "procdump", "printkey", "yarascan", "vaddump")), "")
    if "-h" in args:
        print(GLOBAL + "\n".join(PLUGIN_OPTS.get(plugin, [])))
        return 0
    print("Volatility Foundation Volatility Framework 2.6", file=sys.stderr)
    out, fmt = opt(args, "--output-file"), opt(args, "--output")
    if plugin == "imageinfo":
        doc = {"columns": ["Suggested Profile(s)"],
               "rows": [["Win7SP1x64, Win7SP0x64, Win2008R2SP0x64"]]}
    elif plugin == "pslist":
        doc = PSLIST
    elif plugin == "hashdump":
        doc = HASHDUMP
    elif plugin == "printkey":
        doc = {"columns": ["Registry", "KeyName", "ValName", "ValData"],
               "rows": [["software", (opt(args, "--key") or "ROOT").rsplit("\\", 1)[-1],
                         "VMware Tools", "C:\\Program Files\\VMware\\VMwareTray.exe"]]}
    elif plugin == "yarascan":
        rule = opt(args, "--yara-rules") or ""
        wide = "--wide" in args
        data = URL.decode().encode("utf-16-le") if wide else URL + b"\x00\x05"
        hit = opt(args, "--pid") == "1752" and (rule == "http://" or rule.startswith("{ 68 74"))
        doc = {"columns": ["Rule", "Owner", "Address", "Data"],
               "rows": [["r1", "AcroRd32.exe: (Pid 1752)", 27492610, data.hex()]] if hit else []}
    elif plugin == "vaddump":  # like the real one: files only in text mode
        dump = opt(args, "--dump-dir")
        if fmt == "json" or not dump:
            return 1
        lines = ["Pid        Process              Start      End        Result",
                 "---------- -------------------- ---------- ---------- ------"]
        if opt(args, "--pid") == "1752" and opt(args, "--base") == "0x1f0000":
            name = "AcroRd32.exe.2268020.0x001f0000-0x001f0fff.dmp"
            with open(os.path.join(dump, name), "wb") as fh:
                fh.write(b"%PDF" + b"\x00" * 4092)
            lines.append(f"      1752 AcroRd32.exe         0x001f0000 0x001f0fff {dump}/{name}")
        with open(out, "w") as fh:
            fh.write("\n".join(lines) + "\n")
        return 0
    elif plugin == "cmdline":  # text-only plugin: fails in JSON, works in text
        if fmt == "json":
            print("ERROR   : volatility.debug    : Plugin cmdline is unable to produce output "
                  "in json", file=sys.stderr)
            return 1
        with open(out, "w") as fh:
            fh.write("*" * 72 + "\nSystem pid:      4\n" + "*" * 72
                     + "\npowershell.exe pid:   4312\nCommand line : powershell -enc AAAA\n")
        return 0
    else:
        print(f"fake vol2: unsupported plugin {plugin}", file=sys.stderr)
        return 1
    pid = opt(args, "--pid")
    if pid and "PID" in doc["columns"]:
        i = doc["columns"].index("PID")
        doc = {**doc, "rows": [r for r in doc["rows"] if str(r[i]) == pid]}
    with open(out, "w") as fh:
        json.dump(doc, fh)
    return 0


if __name__ == "__main__":
    sys.exit(main())
