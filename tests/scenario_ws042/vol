#!/usr/bin/env python3
"""Golden-scenario `vol` stub: plugin help + canned JSON from fixtures/<plugin>.json."""
import json
import sys
from pathlib import Path

FIX = Path(__file__).parent / "fixtures"
PLUGINS = {"windows.pslist.PsList": ["--pid [PID ...]  Process ID to include"],
           "windows.pstree.PsTree": ["--pid [PID ...]  Process ID to include"],
           "windows.cmdline.CmdLine": ["--pid [PID ...]  Process IDs to include"],
           "windows.netscan.NetScan": ["--include-corrupt  Radically eases result validation."]}


def main() -> int:
    args = sys.argv[1:]
    plugin = next((a for a in args if a.startswith("windows.")), "")
    if "-h" in args:
        if not plugin:
            print("Volatility 3 Framework 2.28.2\n\n  PLUGIN")
            for p in PLUGINS:
                print(f"    {p}\n                        scenario plugin")
            print("\nThe following plugins could not be loaded (use -vv to see why):")
        else:
            print("options:\n  -h, --help       show this help message and exit")
            for line in PLUGINS.get(plugin, []):
                print("  " + line)
        return 0
    if plugin not in PLUGINS:
        print(f"scenario vol: unsupported {plugin}", file=sys.stderr)
        return 1
    rows = json.loads((FIX / f"{plugin}.json").read_text())
    if "--pid" in args and plugin != "windows.pstree.PsTree":
        pid = int(args[args.index("--pid") + 1])
        rows = [r for r in rows if r.get("PID") == pid]
    print(json.dumps(rows))
    return 0


if __name__ == "__main__":
    sys.exit(main())
